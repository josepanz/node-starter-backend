generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Example {
  id             Int    @id @default(autoincrement())
  email          String @unique
  firstName      String @map("first_name")
  lastName       String @map("last_name")
  documentNumber String @map("document_number")

  // Audit fields
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  isActive        Boolean   @default(true) @map("is_active")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  @@map("example")
}

model AuditLogs {
  id            BigInt   @id @default(autoincrement())
  tableName     String   @map("table_name")
  recordId      String   @map("record_id")
  operationType String   @map("operation_type")
  oldData       Json?    @map("old_data")
  newData       Json?    @map("new_data")
  changedAt     DateTime @default(now()) @map("changed_at")
  changedBy     String   @map("changed_by")

  reason          String? @map("reason")
  ipAddress       String? @map("ip_address")
  userAgent       String? @map("user_agent")
  extraData       String? @map("extra_data")
  audVersion      Int?    @map("aud_version")
  changeSignature String? @map("change_signature")

  @@index([changedAt(sort: Desc)], name: "idx_audit_changed_at")
  @@index([changedBy], name: "idx_audit_changed_by")
  @@index([tableName, recordId], name: "idx_audit_table_record")
  @@map("audit_logs")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
  INACTIVE
  REFUSED
  PENDING_VERIFICATION
}

enum UserProfileStatus {
  INCOMPLETE
  COMPLETE
  DOCUMENT_PENDING
}

enum DocumentType {
  PAS
  CAD
  CIP
  CIE
  DNI
  RUC
  CRC
}

enum AccessLevel {
  COMMERCE // Nivel Empresa/Comercio (RUC completo)
  GROUP // Nivel Agrupación Lógica
  BRANCH // Nivel Sucursal Individual
}

model Users {
  id              Int               @id @default(autoincrement())
  referenceId     String            @unique @default(uuid())
  legacyUserId    String?           @map("legacy_user_id")
  email           String            @unique @map("email")
  status          UserStatus        @default(ACTIVE) @map("status")
  profileStatus   UserProfileStatus @default(INCOMPLETE) @map("profile_status")
  lastLogin       DateTime?         @map("last_login")
  firstName       String            @map("first_name")
  lastName        String            @map("last_name")
  documentType    DocumentType?     @map("document_type")
  documentNumber  String?           @map("document_number")
  phoneNumber     String?           @map("phone_number")
  isEmployee      Boolean           @default(false) @map("is_employee")
  isLdap          Boolean           @default(false) @map("ldap")
  createdAt       DateTime          @default(now()) @map("created_at")
  createdBy       String            @map("created_by")
  lastChangedAt   DateTime?         @default(now()) @map("last_changed_at")
  lastChangedBy   String?           @map("last_changed_by")
  unverifiedEmail String?           @map("unverified_email")
  changedReason   String?           @map("changed_reason")
  acceptedTermsAt DateTime?         @map("accepted_terms_at")

  currentAccessLevel AccessLevel @default(COMMERCE) @map("current_level")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  roles            UserRoles[]
  permissions      UserPermissions[]
  credentials      UserCredentials[]
  orders           Order[]
  PushSubscription PushSubscription[]
  Notification     Notification[]

  @@unique([documentType, documentNumber, email], name: "UK_users_document")
  @@map("users")
}

model DocumentsType {
  id   Int    @id @default(autoincrement())
  name String @map("nombre")

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  @@map("documents_type")
}

model UserRoles {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")
  roleId Int @map("role_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Roles @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Roles {
  id          Int     @id @default(autoincrement())
  name        String  @unique @map("name")
  description String? @map("description")

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  displayName String? @map("display_name")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  rolePermissions RolePermissions[]
  userRoles       UserRoles[]

  @@index([isActive])
  @@map("roles")
}

model Permissions {
  id          Int     @id @default(autoincrement())
  name        String  @unique @map("name")
  description String? @map("description")

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  displayName String? @map("display_name")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  rolePermissions RolePermissions[]
  userPermissions UserPermissions[]

  @@index([name])
  @@index([isActive])
  @@map("permissions")
}

model RolePermissions {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  role       Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermissions {
  id           Int @id @default(autoincrement())
  userId       Int @map("user_id")
  permissionId Int @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  user       Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model UserCredentials {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiredAt    DateTime? @map("expired_at")
  attempts     Int       @default(0) @map("attempts")
  lockedUntil  DateTime? @map("locked_until")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_credentials")
}

model ApiClientCredential {
  id            Int       @id @default(autoincrement())
  clientId      String    @unique @map("client_id")
  clientName    String?   @map("client_name")
  secretKey     String    @unique @map("secret_key")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastChangedAt DateTime? @map("last_changed_at")
  createdBy     String?   @map("created_by")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  @@map("api_client_credential")
}

// Idempotencia genérica: un registro por (scope, key). requestHash = HMAC del request.
enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model IdempotencyRecord {
  id           Int               @id @default(autoincrement())
  key          String            @db.VarChar(128)
  scope        String            @db.VarChar(255)
  requestHash  String            @map("request_hash")
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body")
  expiresAt    DateTime          @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// DEMO de dominio genérico: órdenes con máquina de estados.
enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Order {
  id          Int         @id @default(autoincrement())
  referenceId String      @unique @default(uuid()) @map("reference_id")
  ownerId     Int         @map("owner_id")
  description String?     @db.VarChar(255)
  amount      Decimal     @db.Decimal(18, 2)
  fee         Decimal     @db.Decimal(18, 2)
  currency    String      @default("USD") @db.VarChar(3)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  owner Users @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, status])
  @@map("orders")
}

// Cola de jobs genérica sobre Postgres. Los workers toman lotes con FOR UPDATE SKIP LOCKED.
enum BackgroundJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model BackgroundJob {
  id          Int                 @id @default(autoincrement())
  referenceId String              @unique @default(uuid()) @map("reference_id")
  type        String              @db.VarChar(100)
  payload     Json
  status      BackgroundJobStatus @default(PENDING)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(3) @map("max_attempts")
  nextRunAt   DateTime            @default(now()) @map("next_run_at")
  lastError   String?             @map("last_error")
  result      Json?
  createdBy   Int?                @map("created_by")
  startedAt   DateTime?           @map("started_at")
  finishedAt  DateTime?           @map("finished_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at")

  @@index([status, nextRunAt])
  @@index([type])
  @@map("background_jobs")
}

// Ledger de mensajes salientes (SMS / EMAIL / PUSH). Se escribe PENDING antes de llamar al proveedor.
enum MessageChannel {
  SMS
  EMAIL
  PUSH
}

enum MessageStatus {
  PENDING
  ACCEPTED
  DELIVERED
  UNDELIVERED
  EXPIRED
  REJECTED
  UNAVAILABLE
}

enum MessageContentPolicy {
  NONE
  AUDIT
}

model Message {
  id                Int                  @id @default(autoincrement())
  referenceId       String               @unique @default(uuid()) @map("reference_id")
  channel           MessageChannel
  provider          String               @db.VarChar(50)
  recipient         String               @db.VarChar(255) // siempre enmascarado
  status            MessageStatus        @default(PENDING)
  providerMessageId String?              @map("provider_message_id") @db.VarChar(128)
  providerStatus    String?              @map("provider_status") @db.VarChar(64)
  providerErrorCode String?              @map("provider_error_code") @db.VarChar(128)
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime?            @map("next_attempt_at")
  resentFromId      Int?                 @map("resent_from_id")
  traceId           String?              @map("trace_id") @db.VarChar(64)
  callerIp          String?              @map("caller_ip") @db.VarChar(64)
  callerUserAgent   String?              @map("caller_user_agent") @db.VarChar(256)
  sourceService     String?              @map("source_service") @db.VarChar(128)
  createdBy         Int?                 @map("created_by")
  contentEncrypted  String?              @map("content_encrypted")
  contentHmac       String?              @map("content_hmac") @db.VarChar(64)
  contentPolicy     MessageContentPolicy @default(NONE) @map("content_policy")
  contentExpiresAt  DateTime?            @map("content_expires_at")
  idempotencyKey    String?              @map("idempotency_key") @db.VarChar(128)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at")

  resentFrom Message?  @relation("MessageResend", fields: [resentFromId], references: [id], onDelete: SetNull)
  resends    Message[] @relation("MessageResend")

  @@index([channel, status])
  @@index([providerMessageId])
  @@index([contentPolicy, contentExpiresAt])
  @@index([createdAt])
  @@map("messages")
}

// Push: suscripciones por usuario y bandeja de notificaciones in-app.
enum PushChannel {
  FCM
  WEBPUSH
}

model PushSubscription {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  channel   PushChannel
  token     String      @db.VarChar(512) // token FCM o endpoint Web Push
  p256dh    String?     @db.VarChar(255)
  auth      String?     @db.VarChar(255)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, token])
  @@index([userId, active])
  @@map("push_subscriptions")
}

model Notification {
  id             Int       @id @default(autoincrement())
  referenceId    String    @unique @default(uuid()) @map("reference_id")
  userId         Int       @map("user_id")
  title          String    @db.VarChar(255)
  body           String
  data           Json?
  requiresAction Boolean   @default(false) @map("requires_action")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
