# APPLICATION SETTINGS
PROJECT_NAME="Node starter backend"
PROJECT_DESCRIPTION="Node starter backend API"
BASE_URL="http://localhost:3000/node-starter-backend/api"
PORT=3000
NODE_ENV="local"

# AUTHENTICATION / JWT
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----"

ACCESS_TOKEN_EXPIRES=""
TEMP_TOKEN_EXPIRES=""
REFRESH_TOKEN_EXPIRES=""

# LOGGING / SEQ
SEQ_ENABLED=false
SEQ_URL=""

# DATABASE
# PRISMA
DATABASE_URL="postgresql://postgres:admin@localhost:5432/node_starter?schema=public" # LOCAL

# SEQUELIZE / IBM i Access ODBC Driver / ANOTHER EXAMPLE
DATABASE_CONNECTION_STRING=DRIVER={IBM i Access ODBC Driver};UID=USER;PWD=PASSWORD;SYSTEM=bla-ibmi.etc.com;CCSID=1208;TRIMCHAR=1;

# SERVIDOR DE ENVIO DE CORREOS 
EMAIL_HOST="host"
EMAIL_PORT=25 # 443 si es secure
EMAIL_USER="user"
EMAIL_PASSWORD="password"
EMAIL_DIR="comercio_noreply@dominio.com.py"


# SECURITY - lockout / password policy (opcionales; defaults entre paréntesis)
MAX_LOGIN_ATTEMPTS=5            # intentos fallidos antes de bloquear
LOCKOUT_MINUTES=15              # 0 = bloqueo permanente (estado BLOCKED)
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72          # bcrypt trunca a 72 bytes
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false
PASSWORD_EXPIRATION_DAYS=0      # 0 = las contraseñas no expiran

# CRYPTO (opcionales). Keyring: "id:base64(32 bytes)" separado por comas
ENCRYPTION_KEYS="k1:<base64-32-bytes>"
ENCRYPTION_ACTIVE_KEY_ID="k1"
HMAC_SECRET="<random-secret>"

# IDEMPOTENCIA
IDEMPOTENCY_TTL_HOURS=24

# ORDERS (demo) fee = max(monto * % / 100, mínimo)
ORDER_FEE_PERCENTAGE=2.5
ORDER_FEE_MINIMUM=1

# CLIENTE HTTP SALIENTE (demo ExampleUpstreamClient). AUTH_TYPE: none | basic | api-key | bearer
UPSTREAM_EXAMPLE_BASE_URL="https://httpbin.org"
UPSTREAM_EXAMPLE_TIMEOUT_MS=5000
UPSTREAM_EXAMPLE_AUTH_TYPE=none
UPSTREAM_EXAMPLE_AUTH_USER=""
UPSTREAM_EXAMPLE_AUTH_SECRET=""
UPSTREAM_EXAMPLE_AUTH_HEADER="X-Api-Key"
UPSTREAM_EXAMPLE_RETRY_ATTEMPTS=2
UPSTREAM_EXAMPLE_RETRY_DELAY_MS=200

# SCHEDULER (cron de 6 campos con segundos; el valor `off` deshabilita ese job)
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
JOBS_WORKER_CRON="*/15 * * * * *"
IDEMPOTENCY_PURGE_CRON="0 30 3 * * *"
MESSAGE_PURGE_CRON="0 0 4 * * *"
SMS_DELIVERY_POLL_CRON="0 */2 * * * *"
ACCOUNT_ANONYMIZATION_CRON="0 0 5 * * *"

# COLA DE JOBS (Postgres)
JOBS_BATCH_SIZE=10
JOBS_MAX_ATTEMPTS=3
JOBS_BACKOFF_BASE_SECONDS=30
JOBS_BACKOFF_MAX_SECONDS=3600
JOBS_VISIBILITY_TIMEOUT_MINUTES=15

# LEDGER DE MENSAJES (AUDIT requiere ENCRYPTION_KEYS; HMAC_SECRET habilita /verify-content)
MESSAGE_CONTENT_POLICY=NONE
MESSAGE_CONTENT_RETENTION_DAYS=30
MESSAGE_RETENTION_DAYS=0        # 0 = no se borran filas del ledger
MESSAGE_PURGE_BATCH_SIZE=500

# SMS: infobip | console (sin credenciales se usa console aunque SMS_PROVIDER=infobip)
SMS_PROVIDER=console
INFOBIP_BASE_URL=""
INFOBIP_API_KEY=""
SMS_FROM=""
SMS_TIMEOUT_MS=10000
SMS_DELIVERY_SOURCE=off         # reports | logs | off
SMS_DELIVERY_POLL_LIMIT=100
PHONE_DEFAULT_COUNTRY_CODE=""   # solo dígitos, ej. 1; vacío = se exige formato internacional (+...)

# EMAIL (opcional): sin EMAIL_HOST se usa ConsoleEmailSender
EMAIL_SECURE=""
EMAIL_TIMEOUT_MS=10000

# PUSH (opcional): sin credenciales el canal usa el proveedor Noop
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@example.com"

# REDIS (opcional): sin REDIS_URL, cache/rate limit/nonces usan memoria del proceso
REDIS_URL=""                    # ej. redis://localhost:6379/0
REDIS_KEY_PREFIX="starter:"
REDIS_CONNECT_TIMEOUT_MS=3000

# RATE LIMITING (TTL en segundos)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_TTL_SECONDS=60
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_TTL_SECONDS=60
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_UPLOAD_TTL_SECONDS=60
RATE_LIMIT_SEARCH_LIMIT=60
RATE_LIMIT_SEARCH_TTL_SECONDS=60
RATE_LIMIT_CLIENT_DEFAULT_PER_MINUTE=60   # credenciales M2M sin rateLimitPerMinute propio

# CACHE
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ITEMS=1000
PERMISSIONS_CACHE_TTL_SECONDS=60  # 0 = no cachear la resolución de permisos del usuario

# NONCE / ANTI-REPLAY
NONCE_TTL_SECONDS=120
LOGIN_NONCE_REQUIRED=false      # true exige `nonce` (GET /auth/nonce) en el login

# API CLIENTS M2M
API_CLIENT_BCRYPT_ROUNDS=10
HMAC_TIMESTAMP_WINDOW_SECONDS=300
HMAC_NONCE_REQUIRED=false       # true exige X-Nonce en requests firmados
UPSTREAM_EXAMPLE_SIGNING_SECRET=""  # solo con UPSTREAM_EXAMPLE_AUTH_TYPE=hmac

# CUMPLIMIENTO: baja de cuenta y consentimiento versionado
ACCOUNT_DELETION_GRACE_DAYS=30          # período de gracia antes de anonimizar (0 = en el próximo barrido)
ACCOUNT_ANONYMIZATION_BATCH_SIZE=100
CONSENT_REQUIRED_STATUS=403             # 403 | 451 al faltar el consentimiento vigente

# BITÁCORA: lote del cursor en GET /audit-logs/export (JSON streaming)
AUDIT_EXPORT_BATCH_SIZE=500

# REALTIME (socket.io). Con REDIS_URL se usa el adapter Redis; sin él, in-memory
WS_THROTTLE_LIMIT=20            # mensajes por socket dentro de la ventana
WS_THROTTLE_WINDOW_SECONDS=10
