# =============================================================================
# .env.template - referencia completa. Copiar a `.env` para desarrollo local.
# Los valores son los defaults de config-schema.ts / config-loader.ts.
# Las opcionales de proveedores externos van vacias: la app usa su fallback.
# =============================================================================

# -----------------------------------------------------------------------------
# APP / SERVIDOR
# -----------------------------------------------------------------------------
BASE_URL="http://localhost:3000/node-starter-backend/api"
# local | development | qa | production
NODE_ENV="local"
PORT=3000
PROJECT_DESCRIPTION="Node starter backend API"
PROJECT_NAME="Node starter backend"

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# Postgres / Prisma
DATABASE_URL="postgresql://postgres:admin@localhost:5432/node_starter?schema=public"
# DB2 / Sequelize (ejemplo IBM i Access ODBC Driver)
DATABASE_CONNECTION_STRING=DRIVER={IBM i Access ODBC Driver};UID=USER;PWD=PASSWORD;SYSTEM=bla-ibmi.etc.com;CCSID=1208;TRIMCHAR=1;

# -----------------------------------------------------------------------------
# AUTH / JWT
# Solo desarrollo - regenerar en produccion (PEM; los saltos de linea como \n)
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----"
# Duraciones en formato ms/jsonwebtoken (15m, 1h, 7d)
ACCESS_TOKEN_EXPIRES="15m"
REFRESH_TOKEN_EXPIRES="7d"
# Refresh token de sesion corta (sin "recordarme")
REFRESH_TOKEN_SHORT_EXPIRES="12h"
TEMP_TOKEN_EXPIRES="1h"
# true exige `nonce` (GET /auth/nonce) en el login
LOGIN_NONCE_REQUIRED=false

# -----------------------------------------------------------------------------
# CREDENCIALES: POLITICA DE CONTRASENA Y LOCKOUT
# -----------------------------------------------------------------------------
# 0 = bloqueo permanente (estado BLOCKED)
LOCKOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
# 0 = las contrasenas no expiran
PASSWORD_EXPIRATION_DAYS=0
# bcrypt trunca a 72 bytes
PASSWORD_MAX_LENGTH=72
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_SYMBOL=false
PASSWORD_REQUIRE_UPPERCASE=true

# -----------------------------------------------------------------------------
# CRYPTO
# Solo desarrollo - regenerar en produccion
# Keyring AES-256-GCM: "id:base64(32 bytes)" separado por comas.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# -----------------------------------------------------------------------------
ENCRYPTION_ACTIVE_KEY_ID="k1"
ENCRYPTION_KEYS="k1:Zm84vC5logoZiR8lEE+AZBBIQnwVJzQd0AvkZn2NQ2k="
# Habilita /verify-content en el ledger de mensajes
HMAC_SECRET="3a6580754955b5ff02c14414b888f876f263163a1dd35dfadd83693bda62fb89"

# -----------------------------------------------------------------------------
# IDEMPOTENCIA
# -----------------------------------------------------------------------------
IDEMPOTENCY_TTL_HOURS=24

# -----------------------------------------------------------------------------
# RATE LIMITING (TTL en segundos)
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_TTL_SECONDS=60
# Credenciales M2M sin rateLimitPerMinute propio
RATE_LIMIT_CLIENT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH_LIMIT=60
RATE_LIMIT_SEARCH_TTL_SECONDS=60
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_UPLOAD_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# REDIS / CACHE / NONCE
# Sin REDIS_URL, cache / rate limit / nonces / realtime usan memoria del proceso.
# Local: redis://localhost:6379/0
# -----------------------------------------------------------------------------
REDIS_URL=""
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_KEY_PREFIX="starter:"
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ITEMS=1000
# 0 = no cachear la resolucion de permisos del usuario
PERMISSIONS_CACHE_TTL_SECONDS=60
NONCE_TTL_SECONDS=120

# -----------------------------------------------------------------------------
# M2M / HMAC DE REQUESTS (API clients)
# -----------------------------------------------------------------------------
API_CLIENT_BCRYPT_ROUNDS=10
HMAC_TIMESTAMP_WINDOW_SECONDS=300
# true exige X-Nonce en requests firmados
HMAC_NONCE_REQUIRED=false

# -----------------------------------------------------------------------------
# HTTP CLIENTS UPSTREAM (demo ExampleUpstreamClient)
# AUTH_TYPE: none | basic | api-key | bearer | hmac
# -----------------------------------------------------------------------------
UPSTREAM_EXAMPLE_AUTH_HEADER="X-Api-Key"
UPSTREAM_EXAMPLE_AUTH_SECRET=""
UPSTREAM_EXAMPLE_AUTH_TYPE=none
UPSTREAM_EXAMPLE_AUTH_USER=""
UPSTREAM_EXAMPLE_BASE_URL="https://httpbin.org"
UPSTREAM_EXAMPLE_RETRY_ATTEMPTS=2
UPSTREAM_EXAMPLE_RETRY_DELAY_MS=200
# Solo desarrollo - usado solo con AUTH_TYPE=hmac; regenerar en produccion
UPSTREAM_EXAMPLE_SIGNING_SECRET="571728e13dfb3354d6072d424c7884f0f3fb2127583ceae4b3d1458f7bee197d"
UPSTREAM_EXAMPLE_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# SCHEDULER / JOBS
# Cron de 6 campos (con segundos); el valor `off` deshabilita ese job
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
ACCOUNT_ANONYMIZATION_CRON="0 0 5 * * *"
IDEMPOTENCY_PURGE_CRON="0 30 3 * * *"
JOBS_WORKER_CRON="*/15 * * * * *"
MESSAGE_PURGE_CRON="0 0 4 * * *"
SMS_DELIVERY_POLL_CRON="0 */2 * * * *"
# Cola de jobs (Postgres)
JOBS_BACKOFF_BASE_SECONDS=30
JOBS_BACKOFF_MAX_SECONDS=3600
JOBS_BATCH_SIZE=10
JOBS_MAX_ATTEMPTS=3
JOBS_VISIBILITY_TIMEOUT_MINUTES=15

# -----------------------------------------------------------------------------
# MENSAJERIA: LEDGER
# -----------------------------------------------------------------------------
# NONE | AUDIT (AUDIT requiere ENCRYPTION_KEYS)
MESSAGE_CONTENT_POLICY=NONE
MESSAGE_CONTENT_RETENTION_DAYS=30
MESSAGE_PURGE_BATCH_SIZE=500
# 0 = no se borran filas del ledger
MESSAGE_RETENTION_DAYS=0

# -----------------------------------------------------------------------------
# MENSAJERIA: SMS
# infobip | console. Sin credenciales se usa console aunque SMS_PROVIDER=infobip
# -----------------------------------------------------------------------------
SMS_PROVIDER=console
INFOBIP_API_KEY=""
INFOBIP_BASE_URL=""
# Solo digitos (ej. 1). Vacio = se exige formato internacional (+...)
PHONE_DEFAULT_COUNTRY_CODE=""
# reports | logs | off
SMS_DELIVERY_SOURCE=off
SMS_DELIVERY_POLL_LIMIT=100
SMS_FROM=""
SMS_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# MENSAJERIA: EMAIL / SMTP
# Sin EMAIL_HOST se usa ConsoleEmailSender (solo loguea, no envia)
# -----------------------------------------------------------------------------
EMAIL_HOST=""
EMAIL_PORT=25
EMAIL_USER=""
EMAIL_PASSWORD=""
# Remitente (debe ser un email valido)
EMAIL_DIR=""
# true para TLS implicito (ej. puerto 465/443); vacio = automatico segun el puerto
EMAIL_SECURE=""
EMAIL_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# MENSAJERIA: PUSH (FCM / Web Push)
# Sin credenciales el canal usa el proveedor Noop
# -----------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=""
# Saltos de linea como \n
FIREBASE_PRIVATE_KEY=""
FIREBASE_PROJECT_ID=""
VAPID_PRIVATE_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:soporte@example.com"

# -----------------------------------------------------------------------------
# STORAGE S3
# Sin credenciales/bucket el storage no se habilita
# -----------------------------------------------------------------------------
S3_ACCESS_KEY_ID=""
S3_BUCKET_NAME=""
S3_MAX_CONCURRENCY=5
# Segundos
S3_PRESIGNED_URL_EXPIRES_IN=900
S3_REGION=""
S3_RETRY_ATTEMPTS=0
S3_RETRY_DELAY_MS=250
S3_SECRET_ACCESS_KEY=""

# -----------------------------------------------------------------------------
# COMPLIANCE: baja de cuenta y consentimiento versionado
# -----------------------------------------------------------------------------
ACCOUNT_ANONYMIZATION_BATCH_SIZE=100
# Dias de gracia antes de anonimizar (0 = en el proximo barrido)
ACCOUNT_DELETION_GRACE_DAYS=30
# 403 | 451 al faltar el consentimiento vigente
CONSENT_REQUIRED_STATUS=403

# -----------------------------------------------------------------------------
# AUDITORIA
# -----------------------------------------------------------------------------
# Lote del cursor en GET /audit-logs/export (JSON streaming, 1-5000)
AUDIT_EXPORT_BATCH_SIZE=500

# -----------------------------------------------------------------------------
# OBSERVABILIDAD: Seq, Sentry
# -----------------------------------------------------------------------------
SEQ_ENABLED=false
# Requerido por el schema aunque SEQ_ENABLED=false (puerto por defecto de Seq)
SEQ_URL="http://localhost:5341"
# Sin DSN no se reporta nada. Reporta solo 5xx, con traceId como tag. Ej: https://<key>@<host>/<project>
SENTRY_DSN=""
# Ventana de dedupe del mismo error (0 = sin dedupe)
SENTRY_DEDUPE_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# MONGO
# Sin MONGO_URI el ActivityLog usa un store noop (no se persiste nada).
# Local: mongodb://localhost:27017/starter (docker compose up -d mongo)
# -----------------------------------------------------------------------------
MONGO_URI=""
MONGO_MAX_POOL_SIZE=10
# Expiracion automatica (indice TTL) de las entradas; 0 = nunca
ACTIVITY_LOG_TTL_DAYS=90

# -----------------------------------------------------------------------------
# ORDERS (demo): fee = max(monto * % / 100, minimo)
# -----------------------------------------------------------------------------
ORDER_FEE_MINIMUM=1
ORDER_FEE_PERCENTAGE=2.5

# -----------------------------------------------------------------------------
# OTROS: REALTIME (socket.io)
# Con REDIS_URL se usa el adapter Redis; sin el, in-memory
# -----------------------------------------------------------------------------
# Mensajes por socket dentro de la ventana
WS_THROTTLE_LIMIT=20
WS_THROTTLE_WINDOW_SECONDS=10
