# APPLICATION SETTINGS
PROJECT_NAME="Node starter backend"
PROJECT_DESCRIPTION="Node starter backend API"
BASE_URL="http://localhost:3000/node-starter-backend/api"
PORT=3000
NODE_ENV="local"

# AUTHENTICATION / JWT
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----"

ACCESS_TOKEN_EXPIRES=""
TEMP_TOKEN_EXPIRES=""
REFRESH_TOKEN_EXPIRES=""

# LOGGING / SEQ
SEQ_ENABLED=false
SEQ_URL=""

# DATABASE
# PRISMA
DATABASE_URL="postgresql://postgres:admin@localhost:5432/node_starter?schema=public" # LOCAL

# SEQUELIZE / IBM i Access ODBC Driver / ANOTHER EXAMPLE
DATABASE_CONNECTION_STRING=DRIVER={IBM i Access ODBC Driver};UID=USER;PWD=PASSWORD;SYSTEM=bla-ibmi.etc.com;CCSID=1208;TRIMCHAR=1;

# SERVIDOR DE ENVIO DE CORREOS 
EMAIL_HOST="host"
EMAIL_PORT=25 # 443 si es secure
EMAIL_USER="user"
EMAIL_PASSWORD="password"
EMAIL_DIR="comercio_noreply@dominio.com.py"


# SECURITY - lockout / password policy (opcionales; defaults entre paréntesis)
MAX_LOGIN_ATTEMPTS=5            # intentos fallidos antes de bloquear
LOCKOUT_MINUTES=15              # 0 = bloqueo permanente (estado BLOCKED)
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72          # bcrypt trunca a 72 bytes
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false
PASSWORD_EXPIRATION_DAYS=0      # 0 = las contraseñas no expiran

# CRYPTO (opcionales). Keyring: "id:base64(32 bytes)" separado por comas
ENCRYPTION_KEYS="k1:<base64-32-bytes>"
ENCRYPTION_ACTIVE_KEY_ID="k1"
HMAC_SECRET="<random-secret>"

# IDEMPOTENCIA
IDEMPOTENCY_TTL_HOURS=24

# ORDERS (demo) fee = max(monto * % / 100, mínimo)
ORDER_FEE_PERCENTAGE=2.5
ORDER_FEE_MINIMUM=1

# CLIENTE HTTP SALIENTE (demo ExampleUpstreamClient). AUTH_TYPE: none | basic | api-key | bearer
UPSTREAM_EXAMPLE_BASE_URL="https://httpbin.org"
UPSTREAM_EXAMPLE_TIMEOUT_MS=5000
UPSTREAM_EXAMPLE_AUTH_TYPE=none
UPSTREAM_EXAMPLE_AUTH_USER=""
UPSTREAM_EXAMPLE_AUTH_SECRET=""
UPSTREAM_EXAMPLE_AUTH_HEADER="X-Api-Key"
UPSTREAM_EXAMPLE_RETRY_ATTEMPTS=2
UPSTREAM_EXAMPLE_RETRY_DELAY_MS=200
